VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Opcional. Déjalo vacío para usar la API local incluida con Vite.
# Usa http://127.0.0.1:8787 cuando el backend Python/GTFS esté configurado.
METROBUS_API_TARGET=

# Credenciales solo de servidor; en Vercel, configurar en Production.
# No usar prefijo VITE_ para estos secretos.
METROBUS_USER=
METROBUS_PASSWORD=
# Opcional si el backend propio requiere autenticación.
METROBUS_API_TOKEN=
